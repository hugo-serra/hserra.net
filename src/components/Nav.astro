---
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Blog", href: "/blog" },
  { label: "Resume", href: "/resume" },
  { label: "Contact", href: "/contact" },
];

const path = Astro.url.pathname;
---

<header class="nav site-nav">
  <a class="nav-brand" href="/">Hugo Serra</a>
  <nav class="site-nav-links" aria-label="Main navigation">
    {
      navLinks.map(({ label, href }) => (
        <a
          href={href}
          aria-current={
            path === href || (href !== "/" && path.startsWith(href))
              ? "page"
              : undefined
          }
        >
          {label}
        </a>
      ))
    }
  </nav>
  <button
    class="theme-btn"
    id="theme-toggle"
    aria-label="Switch theme"
    type="button"
  >
    <!-- Sun: shown in dark mode, click to go light -->
    <svg
      class="nav-icon nav-icon--sun"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path>
    </svg>
    <!-- Moon: shown in light mode, click to go dark -->
    <svg
      class="nav-icon nav-icon--moon"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
</header>

<!--
  Site nav layout — composed on top of the DS .nav (app-shell) primitive.
  The DS .nav is a single non-wrapping row (brand + right-aligned actions);
  a personal site has visible text links that must survive a 320px phone.
  Mobile-first: brand + toggle share the top row, links wrap to a full-width
  second row. From 640px it collapses to a single right-aligned row.
  Follow-up: this nav-link pattern could graduate into @hs/design.
-->
<style>
  .site-nav {
    flex-wrap: wrap;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    padding-block: var(--space-1);
  }

  .nav-brand {
    order: 1;
  }

  /* Toggle holds the top-right corner alongside the brand on phone. */
  .theme-btn {
    order: 2;
    margin-left: auto;
  }

  /* Links drop to their own full-width row on phone; wrap, never overflow. */
  .site-nav-links {
    order: 3;
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    /* Pull the first link flush with the brand above it. */
    margin-inline-start: calc(-1 * var(--space-2));
  }

  .site-nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .site-nav-links a:hover {
    color: var(--color-ink);
  }

  /* Current page — primary is the system's "you are here" signal. */
  .site-nav-links a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: var(--weight-medium);
  }

  .site-nav-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Tablet and up — single row: brand left, links + toggle right. */
  @media (min-width: 640px) {
    .site-nav-links {
      order: 2;
      flex-basis: auto;
      flex-wrap: nowrap;
      margin-inline-start: auto;
      gap: var(--space-2);
    }

    .site-nav-links a {
      /* Compact desktop hit area; 44px is for touch. */
      min-height: 32px;
    }

    .theme-btn {
      order: 3;
      margin-left: var(--space-1);
    }
  }
</style>

<!-- Icon visibility: sun shown in dark mode, moon shown in light mode -->
<style is:global>
  .nav-icon--sun {
    display: none;
  }
  .nav-icon--moon {
    display: block;
  }
  [data-theme="dark"] .nav-icon--sun {
    display: block;
  }
  [data-theme="dark"] .nav-icon--moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    html:not([data-theme]) .nav-icon--sun {
      display: block;
    }
    html:not([data-theme]) .nav-icon--moon {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const html = document.documentElement;
    const isDark =
      html.getAttribute("data-theme") === "dark" ||
      (!html.hasAttribute("data-theme") &&
        window.matchMedia("(prefers-color-scheme: dark)").matches);
    const next = isDark ? "light" : "dark";
    html.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });
</script>
