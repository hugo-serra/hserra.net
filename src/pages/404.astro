---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Hugo Serra" description="Page not found.">
  <div class="container not-found">
    <div class="empty">
      <p class="empty-title">404 — Page not found</p>
      <p class="empty-desc">¯\_(ツ)_/¯ This page doesn't exist.</p>
      <div class="empty-actions">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/blog" class="btn btn-ghost">Read the blog</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding-block: var(--space-16);
  }
</style>
