---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@utils/getSortedPosts";

const posts = await getCollection("blog");
const latestPost = getSortedPosts(posts)[0];

const skills = [
  {
    layer: "Backend",
    items: [
      "Python",
      "Django",
      "Django REST Framework",
      "Flask",
      "Node.js",
      "Express.js",
    ],
  },
  {
    layer: "Frontend",
    items: ["React", "Next.js", "TypeScript", "Redux", "React Query"],
  },
  {
    layer: "Infrastructure",
    items: ["AWS", "Azure", "Docker", "Kubernetes", "Terraform", "PostgreSQL"],
  },
  {
    layer: "Leadership",
    items: [
      "Team Management",
      "Agile / Scrum",
      "Mentoring",
      "Hiring",
      "Architecture",
    ],
  },
];
---

<BaseLayout
  title="Hugo Serra — Software Engineer"
  description="Hugo Serra is a senior full stack engineer and team leader based in Lisbon, Portugal."
>
  <div class="container">
    <section class="hero">
      <h1>Hugo Serra</h1>
      <p class="hero-sub">
        Senior full stack engineer and team leader based in Lisbon, Portugal. I
        build data-heavy products, lead distributed teams, and spend too much
        time thinking about LLMs.
      </p>
      <div class="hero-links">
        <a href="/blog" class="btn btn-primary">Read the blog</a>
        <a href="/about" class="btn btn-ghost">About me</a>
      </div>
    </section>

    <section class="skills-section">
      <h2>What I work with</h2>
      <div class="skill-groups">
        {
          skills.map(({ layer, items }) => (
            <div class="skill-group">
              <h3 class="skill-layer">{layer}</h3>
              <div class="skill-tags">
                {items.map(item => (
                  <span class="badge badge-muted">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {
      latestPost && (
        <section class="latest-post">
          <h2>Latest post</h2>
          <ul class="post-list">
            <li class="post-item">
              <a
                class="post-item-link"
                href={`/blog/${latestPost.data.slug ?? latestPost.id.replace(/\.mdx?$/, "")}`}
              >
                <div class="post-meta">
                  <time
                    class="post-date"
                    datetime={latestPost.data.pubDatetime.toISOString()}
                  >
                    {latestPost.data.pubDatetime.toLocaleDateString("en-GB", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                    })}
                  </time>
                </div>
                <h2 class="post-title">{latestPost.data.title}</h2>
                <p class="post-excerpt">{latestPost.data.description}</p>
              </a>
              <div class="post-tags">
                {latestPost.data.tags.map(tag => (
                  <span class="badge badge-muted">{tag}</span>
                ))}
              </div>
            </li>
          </ul>
          <a href="/blog" class="all-posts-link">
            All posts →
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-12);
    max-width: 48rem;
  }

  .hero h1 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-4);
  }

  @media (min-width: 640px) {
    .hero h1 {
      font-size: clamp(var(--text-2xl), 5vw, 3rem);
    }
  }

  .hero-sub {
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.7;
    max-width: 44ch;
    margin-block-end: var(--space-8);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .skills-section {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .skills-section h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-6);
  }

  .skill-groups {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .skill-groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .skill-groups {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skill-layer {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  .latest-post {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .latest-post h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-6);
  }

  .all-posts-link {
    display: inline-block;
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }
</style>
