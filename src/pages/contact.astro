---
import BaseLayout from "@layouts/BaseLayout.astro";

// Public endpoint for the self-hosted contact function (UM300 via Cloudflare
// Tunnel). Set PUBLIC_CONTACT_ENDPOINT in the environment to enable the form;
// when unset, the page degrades to social links only — it never POSTs to a
// missing backend.
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;

// Cloudflare Turnstile sitekey. When set, the form renders the challenge widget
// and submits its token; the backend verifies it. Optional — the form still
// works without it (backend skips verification when its secret is unset).
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;

const socialLinks = [
  {
    label: "GitHub",
    href: "https://github.com/hugo-serra",
    desc: "Code and projects",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/hserra0",
    desc: "Professional profile",
  },
  {
    label: "Twitter / X",
    href: "https://twitter.com/hserra0",
    desc: "@hserra0",
  },
  {
    label: "Medium",
    href: "https://hserra.medium.com/",
    desc: "Longer writing",
  },
];

const sub = contactEndpoint
  ? "Drop me a message below, or find me on LinkedIn."
  : "The best way to reach me is via LinkedIn.";
---

<BaseLayout
  title="Contact — Hugo Serra"
  description="Get in touch with Hugo Serra."
>
  <div class="container">
    <div class="page-header">
      <h1>Contact</h1>
      <p class="page-sub">{sub}</p>
    </div>

    <div class="contact-layout">
      {
        contactEndpoint && (
          <section class="contact-section">
            <h2>Send a message</h2>
            <form id="contact-form" data-endpoint={contactEndpoint} novalidate>
              <div class="field">
                <label class="field-label" for="cf-name">
                  Name
                </label>
                <input
                  class="field-input"
                  id="cf-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                />
              </div>

              <div class="field">
                <label class="field-label" for="cf-email">
                  Email
                </label>
                <input
                  class="field-input"
                  id="cf-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="field">
                <label class="field-label" for="cf-message">
                  Message
                </label>
                <textarea
                  class="field-textarea"
                  id="cf-message"
                  name="message"
                  rows="6"
                  required
                />
              </div>

              {/* Honeypot — hidden from humans, catches naive bots. */}
              <div class="cf-hp" aria-hidden="true">
                <label for="cf-company">Company</label>
                <input
                  id="cf-company"
                  name="company"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>

              {turnstileSitekey && (
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSitekey}
                  data-theme="auto"
                />
              )}

              <div
                id="cf-status"
                class="cf-status"
                role="status"
                aria-live="polite"
              />

              <div class="form-actions">
                <button class="btn btn-primary" type="submit" id="cf-submit">
                  Send message
                </button>
              </div>
            </form>
          </section>
        )
      }

      <section class="contact-section">
        <h2>Elsewhere</h2>
        <ul class="social-list">
          {
            socialLinks.map(({ label, href, desc }) => (
              <li>
                <a
                  class="tile-link social-tile"
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="social-name">{label}</span>
                  <span class="social-desc">{desc}</span>
                  <svg
                    class="social-arrow"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  {
    turnstileSitekey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )
  }
</BaseLayout>

<script>
  const form = document.getElementById(
    "contact-form"
  ) as HTMLFormElement | null;

  if (form) {
    const endpoint = form.dataset.endpoint!;
    const submit = document.getElementById("cf-submit") as HTMLButtonElement;
    const status = document.getElementById("cf-status")!;

    const setStatus = (
      kind: "info" | "danger",
      title: string,
      desc: string
    ) => {
      status.className = `cf-status alert alert-${kind}`;
      status.innerHTML = `<div class="alert-body"><span class="alert-title"></span><span class="alert-desc"></span></div>`;
      (status.querySelector(".alert-title") as HTMLElement).textContent = title;
      (status.querySelector(".alert-desc") as HTMLElement).textContent = desc;
    };

    form.addEventListener("submit", async e => {
      e.preventDefault();

      // Honeypot: a filled hidden field means a bot. Pretend success, do nothing.
      const data = new FormData(form);
      if ((data.get("company") as string)?.trim()) {
        setStatus("info", "Message sent", "Thanks — I'll get back to you.");
        form.reset();
        return;
      }

      const payload = {
        name: (data.get("name") as string)?.trim(),
        email: (data.get("email") as string)?.trim(),
        message: (data.get("message") as string)?.trim(),
        turnstileToken: (data.get("cf-turnstile-response") as string) ?? "",
      };

      if (!payload.name || !payload.email || !payload.message) {
        setStatus(
          "danger",
          "Missing fields",
          "Please fill in your name, email, and message."
        );
        return;
      }

      // If the Turnstile widget is present, it must have produced a token.
      const hasChallenge = !!form.querySelector(".cf-turnstile");
      if (hasChallenge && !payload.turnstileToken) {
        setStatus(
          "danger",
          "Almost there",
          "Please complete the verification challenge."
        );
        return;
      }

      submit.classList.add("btn--loading");
      submit.setAttribute("aria-busy", "true");
      submit.disabled = true;

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        setStatus(
          "info",
          "Message sent",
          "Thanks — I'll get back to you soon."
        );
        form.reset();
      } catch (err) {
        setStatus(
          "danger",
          "Couldn't send message",
          "Something went wrong. Please try again, or reach me on LinkedIn."
        );
      } finally {
        submit.classList.remove("btn--loading");
        submit.removeAttribute("aria-busy");
        submit.disabled = false;
        // Turnstile tokens are single-use — reset for any subsequent submit.
        (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
      }
    });
  }
</script>

<style>
  .page-header {
    padding-block: var(--space-12) var(--space-8);
  }

  .page-header h1 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-2);
  }

  .page-sub {
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-block-end: var(--space-16);
    max-width: 36rem;
  }

  .contact-section h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-4);
  }

  #contact-form .field {
    margin-block-end: var(--space-4);
  }

  .cf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cf-status:not(.alert) {
    display: none;
  }

  .cf-status.alert {
    margin-block-end: var(--space-4);
  }

  .social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  /* Social tile: network name primary, descriptor secondary, external-link
     arrow top-right. Composed on the DS .tile-link surface. */
  .social-tile {
    position: relative;
    justify-content: flex-start;
    align-items: flex-start;
    gap: var(--space-1);
    padding: var(--space-4);
    padding-inline-end: var(--space-8); /* room for the arrow */
  }

  .social-name {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    line-height: 1.3;
  }

  .social-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.4;
  }

  .social-arrow {
    position: absolute;
    top: var(--space-4);
    inset-inline-end: var(--space-4);
    color: var(--color-muted);
    transition:
      color var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-fast) var(--ease-out-quart);
  }

  .social-tile:hover .social-arrow,
  .social-tile:focus-visible .social-arrow {
    color: var(--color-primary);
    transform: translate(1px, -1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-arrow {
      transition: color var(--duration-fast) var(--ease-out-quart);
    }
    .social-tile:hover .social-arrow,
    .social-tile:focus-visible .social-arrow {
      transform: none;
    }
  }
</style>
