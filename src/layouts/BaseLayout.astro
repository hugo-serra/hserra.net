---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
}

const props = Astro.props;

const footerLinks = [
  { label: "GitHub", href: "https://github.com/hugo-serra" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/hserra0" },
  { label: "Twitter / X", href: "https://twitter.com/hserra0" },
  { label: "RSS", href: "/rss.xml" },
];
---

<Layout {...props}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <footer>
    <div class="container footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Hugo Serra</p>
      <nav class="footer-links" aria-label="Elsewhere">
        {
          footerLinks.map(({ label, href }) => (
            <a
              href={href}
              {...(href.startsWith("http")
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </footer>
</Layout>

<style>
  main {
    flex: 1;
  }

  /* Skip link — hidden until focused, then anchored top-left over the nav. */
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-decoration: none;
    transform: translateY(-150%);
    transition: transform var(--duration-fast) var(--ease-out-quart);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }

  footer {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-copy {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .footer-links a {
    color: var(--color-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .footer-links a {
      min-height: 32px;
    }
  }
</style>
